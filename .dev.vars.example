# Local env for `wrangler pages dev` (KAI-96 feedback function).
# Copy to `.dev.vars` and fill in real values — never commit `.dev.vars`.
SUPABASE_URL=https://<project-ref>.supabase.co
# KAI-137: modern Supabase `sb_secret_...` key. Sent ONLY as the `apikey`
# header to /rest/v1/feedback and /auth/v1/user — never as
# Authorization: Bearer. Replaces the legacy SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=<sb_secret_...-key>
# Optional owner notification via Resend (free tier). Domain must be verified
# in Resend; RESEND_FROM defaults to Meguruto <feedback@meguruto.app>.
RESEND_API_KEY=<resend-api-key>
# KAI-44: publishable (anon) key used for user-authentication calls (the
# password grant in the account-deletion function). Never the service key.
SUPABASE_PUBLISHABLE_KEY=<anon-key>
# RESEND_FROM=Meguruto <feedback@meguruto.app>
# KAI-226: server-side OpenRouteService key for /api/car-route. Held ONLY in
# the Pages Function environment — never a VITE_* browser variable.
OPENROUTESERVICE_API_KEY=<openrouteservice-api-key>
