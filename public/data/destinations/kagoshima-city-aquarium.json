    "en": {
      "name": "Kagoshima City Aquarium",
      "description": "Kagoshima City Aquarium (Io World) showcases the rich marine life of the Kuroshio Current that flows past Kagoshima. Its star attraction is the massive Kuroshio Tank featuring whale sharks, the world's largest fish. The aquarium offers dolphin shows and interactive touch pools, all with Sakurajima volcano as the backdrop.",
      "highlights": [
        "Whale sharks in the Kuroshio Tank",
        "Sakurajima volcano backdrop from waterfront",
        "Dolphin shows & interactive touch pools"
      ],
      "openingHours": "09:30–18:00"
    },
    "ja": {
      "name": "いおワールドかごしま水族館",
      "description": "いおワールドかごしま水族館は、鹿児島沖を流れる黒潮の豊かな海洋生物を紹介する水族館です。最大の見どころはジンベエザメが泳ぐ巨大な黒潮大水槽で、桜島を背景にしたイルカショーやふれあいタッチプールも楽しめます。",
      "highlights": [
        "ジンベエザメが泳ぐ黒潮大水槽",
        "桜島を背景にしたイルカショー",
        "ふれあいタッチプール体験"
      ],
      "openingHours": "09:30～18:00"
    }
  },
