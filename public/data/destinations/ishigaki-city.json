  "content": {
    "en": {
      "name": "Ishigaki City",
      "description": "The main hub city of the Yaeyama Island group, world-famous for Kabira Bay's emerald waters, manta ray scuba diving spots, and ferry links to Taketomi and Iriomote.",
      "highlights": [
        "Ride glass-bottom boats in picturesque Kabira Bay",
        "Hop on island ferries from Euglena Ishigaki Port terminal",
        "Taste authentic Ishigaki Wagyu beef and Yaeyama Soba noodles"
      ],
      "reservationInfo": "City hub access free; ferry rides recommended booking ahead in high season.",
      "parkingInfo": "Paid coin parking available around port and city center.",
      "openingHours": "24/7 city access."
    },
    "ja": {
      "name": "石垣市",
      "description": "八重山諸島の玄関口。ミシュラン三ツ星の川平湾や石垣牛、竹富島・西表島への離島フェリーターミナルが集積するアイランドリゾートシティ。",
      "highlights": [
        "エメラルドグリーンのグラスボート絶景・川平湾",
        "ユーグレナ石垣港離島ターミナルからの八重山離島巡り",
        "極上の石垣牛炭火焼肉と八重山そばグルメ"
      ],
      "reservationInfo": "市街アクセス自由。離島フェリーは繁忙期事前予約推奨。",
      "parkingInfo": "港周辺および市街地に有料駐車場多数。",
      "openingHours": "終日アクセス可能。"
    }
