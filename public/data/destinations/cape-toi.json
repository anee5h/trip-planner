    "en": {
      "name": "Cape Toi",
      "description": "A scenic cape at the southern tip of Miyazaki Prefecture known for its population of semi-wild Misaki horses, which have roamed freely here for over 300 years. Features a prominent white lighthouse and stunning ocean views.",
      "highlights": [
        "Observe the semi-wild Misaki horses grazing freely",
        "Panoramic views of the Pacific Ocean from the cape",
        "Visit the historic Cape Toi Lighthouse"
      ],
      "openingHours": "Open 24 hours. Lighthouse open 09:00 - 16:30."
    },
    "ja": {
      "name": "都井岬",
      "description": "宮崎県最南端に位置する景勝地。約300年前から野生馬（御崎馬）が生息していることで知られています。白亜の灯台や太平洋の絶景が楽しめます。",
      "highlights": [
        "野生の御崎馬が草を食む姿を観察",
        "太平洋を見渡す絶景パノラマ",
        "歴史ある都井岬灯台の見学"
      ],
      "openingHours": "24時間開放。灯台は09:00〜16:30。"
    }
  },
