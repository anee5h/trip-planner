  "content": {
    "en": {
      "name": "Kita-in",
      "description": "Seiya-san Muryōshuji Kita-in (星野山無量寿寺喜多院) is a Buddhist temple located in the city of Kawagoe in Saitama Prefecture, Japan. It is noted for its main hall, which was part of the original Edo Castle, and the statues of 540 Rakan, disciples of the Buddha. It is also known informally as the Kawagoe Daishi (川越大師).",
      "highlights": ["Culture"]
    },
    "ja": {
      "name": "喜多院",
      "description": "喜多院（きたいん）は、埼玉県川越市にある天台宗の寺院。山号は星野山（せいやさん）。本尊は阿弥陀如来。",
      "highlights": ["展望"]
    }
  },
