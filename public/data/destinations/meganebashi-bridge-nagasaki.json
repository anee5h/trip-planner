    "en": {
      "name": "Meganebashi Spectacles Bridge",
      "description": "Meganebashi (Spectacles Bridge) is Japan's oldest stone arch bridge, built in 1634 over the Nakashima River. Its name comes from the reflection of its twin arches in the water, which together form the shape of spectacles. The bridge survived the 1945 atomic bombing and remains a beloved symbol of Nagasaki.",
      "highlights": [
        "Japan's oldest stone arch bridge (1634)",
        "Spectacle-shaped reflection on the water",
        "Survived 1945 atomic bombing intact"
      ]
    },
    "ja": {
      "name": "眼鏡橋",
      "description": "眼鏡橋は1634年に中島川に架けられた日本最古の石造アーチ橋です。二連アーチが水面に映り眼鏡のように見えることから名付けられました。1945年の原爆投下にも耐えて現存し、長崎のシンボルとして親しまれています。",
      "highlights": [
        "日本最古の石造二連アーチ橋（1634年）",
        "水面に映る眼鏡のような美しいフォルム",
        "1945年原爆にも耐えた長崎の象徴"
      ]
    }
  },
