    "en": {
      "name": "Omiya Park",
      "description": "Ōmiya Park (大宮公園, Ōmiya Kōen) is a public park located 1 km (0.62 mi) northeast of Ōmiya Station and the most visited park in Saitama. The park encompasses a huge area of 67.9 ha (168 acres) (as of 2004) and is famous for Japanese Red Pine forest and cherry blossoms. In particular, the park ranks in the Top 100 Locations in Japan for Cherry Blossoms.",
      "highlights": ["Nature"]
    },
    "ja": {
      "name": "大宮公園",
      "description": "大宮公園（おおみやこうえん）は、埼玉県さいたま市大宮区および見沼区にある、67.8 haの面積を有する埼玉県営の都市公園（広域公園）である。1990年（平成2年）に日本さくら名所100選に選定。",
      "highlights": ["自然"]
    }
