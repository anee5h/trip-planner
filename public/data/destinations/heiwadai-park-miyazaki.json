    "en": {
      "name": "Heiwadai Park & Haniwa Garden",
      "description": "Heiwadai Park is a hilltop park built to commemorate the 2,600th anniversary of the legendary Emperor Jimmu's enthronement. Its centerpiece is the 37-meter Peace Tower, and the adjacent Haniwa Garden displays hundreds of replica ancient clay figures (haniwa) excavated from local burial mounds, offering a unique glimpse into Japan's Kofun period.",
      "highlights": [
        "37m Peace Tower monument",
        "Hundreds of replica haniwa clay figures",
        "Panoramic hilltop views of Miyazaki"
      ]
    },
    "ja": {
      "name": "平和台公園・はにわ園",
      "description": "平和台公園は神武天皇即位2600年を記念して造られた丘陵公園で、中心にそびえる高さ37mの平和の塔が象徴的です。隣接するはにわ園には宮崎県内の古墳から出土した埴輪のレプリカ数百体が展示され、古代のロマンを感じさせます。",
      "highlights": [
        "高さ37mの平和の塔",
        "数百体の埴輪レプリカ展示",
        "丘の上からの宮崎市街パノラマ"
      ]
    }
  },
