    "en": {
      "name": "Fukushuen Garden",
      "description": "A serene traditional Chinese landscape garden constructed in Naha's Kumemura district using granite and wood imported from Fuzhou, China.",
      "highlights": [
        "Stroll across stone arch bridges and fish-filled ponds",
        "Admire Chinese wooden pavilions, pagodas, and artificial waterfall",
        "Experience quiet tea house refreshments inside the garden"
      ],
      "reservationInfo": "Tickets purchased at entrance.",
      "parkingInfo": "Paid parking available at adjacent Matsuyama Park lot.",
      "openingHours": "09:00 - 18:00 (Closed Wednesdays)."
    },
    "ja": {
      "name": "福州園",
      "description": "那覇市と中国・福州市の友好都市締結10周年を記念して作られた本格的中国庭園。滝や石橋、木造楼閣が美しい静かな癒やしスポット。",
      "highlights": [
        "福州市の建築様式を取り入れた美しい木造楼閣と石橋",
        "築山から流れ落ちる滝と鯉が泳ぐ池の庭園回遊",
        "クメムラ（久米村）の歴史に触れられる伝統空間"
      ],
      "reservationInfo": "現地窓口でチケット購入。",
      "parkingInfo": "近隣の松山公園駐車場等を利用。",
      "openingHours": "09:00〜18:00（水曜定休）。"
    }
