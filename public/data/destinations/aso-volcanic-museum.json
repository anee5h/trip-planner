    "en": {
      "name": "Aso Volcano Museum",
      "description": "The Aso Volcano Museum sits at the foot of Nakadake Crater and offers a fascinating introduction to the geology and history of Mount Aso. Live camera feeds from inside the crater, 3D volcano models, and exhibits on the 1990s eruption make it an essential stop before or after visiting the crater itself.",
      "highlights": [
        "Live crater camera feeds & volcano science",
        "3D models of Mount Aso's geology",
        "Interactive eruption history exhibits"
      ],
      "openingHours": "09:00–17:00"
    },
    "ja": {
      "name": "阿蘇火山博物館",
      "description": "阿蘇火山博物館は中岳火口の麓に位置し、阿蘇山の地質と噴火の歴史をわかりやすく紹介する博物館です。火口内部のライブカメラ映像、3D火山模型、1990年代の噴火に関する展示があり、火口見学の前後に立ち寄るのに最適です。",
      "highlights": [
        "火口ライブカメラと火山の科学展示",
        "阿蘇山の3D地質模型",
        "噴火の歴史と体験型展示"
      ],
      "openingHours": "09:00～17:00"
    }
  },
