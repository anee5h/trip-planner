  "content": {
    "en": {
      "name": "Inamuragasaki",
      "description": "Inamuragasaki (稲村ケ崎) is a cape at the western end of Yuigahama (Beach) in Kamakura, Kanagawa Prefecture, Japan. The cape divides Yuigahama from Shichirigahama (Beach) and Enoshima.  Its name seems to stem from its shape, similar to a stack of rice at harvest time (an inamura (稲叢)).",
      "highlights": ["Culture"]
    },
    "ja": {
      "name": "稲村ヶ崎",
      "description": "稲村ヶ崎（いなむらがさき）は、神奈川県鎌倉市南西部にある岬で、由比ヶ浜と七里ヶ浜の間にあたる。通常、「稲村ヶ崎」の表記は歴史的用法や国の史跡の名称に使用し、地名としては住居表示に伴う町名変更で稲村ガ崎一丁目から稲村ガ崎五丁目となっている。",
      "highlights": ["展望"]
    }
  },
