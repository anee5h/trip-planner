  "content": {
    "en": {
      "name": "Shuri Castle & Ryukyu Gusuku Sites",
      "description": "The historic palace complex of the Ryukyu Kingdom, featuring the iconic Shureimon Gate, stone fortification walls, and ongoing historic main hall reconstruction work.",
      "highlights": [
        "Pass through iconic Shureimon Gate and Kankaimon Gate",
        "Observe active traditional restoration of Seiden main hall",
        "Panoramic views over Naha City from Una forecourt and fortress walls"
      ],
      "reservationInfo": "Tickets available at gate or online in advance.",
      "parkingInfo": "Paid underground parking on site (¥320/hour).",
      "openingHours": "08:30 - 18:00 daily (Paid area admission until 17:30)."
    },
    "ja": {
      "name": "首里城と琉球王国のグスク",
      "description": "かつて琉球王国の政治・外交・文化の中心であった王宮。守礼門や石垣の美しさ、正殿復元作業の公開が注目の世界遺産。",
      "highlights": [
        "礼節を重んじる琉球文化の象徴「守礼門」と「歓会門」",
        "令和の正殿復元作業現場の特別見学",
        "城郭高台から見渡す那覇市街の絶景パノラマ"
      ],
      "reservationInfo": "有料区域チケットは現地窓口または事前オンラインで購入可能。",
      "parkingInfo": "首里城公園地下駐車場あり（小型車1回320円）。",
      "openingHours": "08:30〜18:00（有料区域最終入園17:30）。"
    }
  },
