  "content": {
    "en": {
      "name": "Bise Fukugi Tree-Lined Village",
      "description": "A quiet coastal village surrounded by thousands of ancient Garcinia (Fukugi) windbreak trees forming green vaulted tunnels that filter sunlight down to sandy footpaths.",
      "highlights": [
        "Walk or rent a bicycle along 1km of shaded emerald tree tunnels",
        "Ride a traditional water-buffalo cart guided by local villagers",
        "Reach Bise-zaki point at the end of the path for coral snorkeling"
      ],
      "reservationInfo": "Walking path free; water buffalo cart rides booked on site.",
      "parkingInfo": "Paid parking lot at Bise-zaki entrance (¥500/day).",
      "openingHours": "Open 24/7; daytime walking recommended (08:00 - 18:00)."
    },
    "ja": {
      "name": "備瀬のフクギ並木",
      "description": "台風から家々を守るため植えられた数千本のフクギが並ぶ古き良き沖縄の集落。緑のトンネルに木漏れ日が差し込む幻想的な散策路。",
      "highlights": [
        "約1kmにわたり続く緑豊かなフクギのトンネル散歩・レンタサイクル",
        "三線の音色を聞きながら巡る伝統の水牛車観光",
        "並木道を抜けた備瀬崎海岸でのイノー（浅瀬）観察とシュノーケリング"
      ],
      "reservationInfo": "散策自由。水牛車体験は現地受付。",
      "parkingInfo": "備瀬崎入口付近に有料駐車場あり（500円/日）。",
      "openingHours": "終日散策可能（日中の見学08:00〜18:00推奨）。"
    }
