  "content": {
    "en": {
      "name": "Nakijin Castle Ruins",
      "description": "A 14th-century World Heritage fortress of the Hokuzan Kingdom featuring undulating Ryukyu limestone walls snake-like along mountain ridges with sweeping East China Sea ocean views.",
      "highlights": [
        "Walk along massive 1.5km curving limestone walls resembling the Great Wall",
        "Take in breathtaking panoramic views of the East China Sea horizon",
        "See early Ryukyu cherry blossoms flowering along the stone steps in January-February"
      ],
      "reservationInfo": "Tickets purchased at ticket office at entrance.",
      "parkingInfo": "Free visitor parking available on site.",
      "openingHours": "08:00 - 18:00 (May to August until 19:00)."
    },
    "ja": {
      "name": "今帰仁城跡",
      "description": "14世紀の北山王の居城跡。龍の背のようにうねる琉球石灰岩の堅牢な城壁と、高台から望むエメラルドグリーンの東シナ海が美しい世界遺産。",
      "highlights": [
        "城壁の曲線美が際立つ全長1.5kmの石垣と平郎門（正門）",
        "主郭跡から見渡す断崖絶壁と東シナ海の水平線",
        "毎年1月下旬〜2月上旬に咲き誇る日本一早いカンヒザクラ（寒緋桜）の名所"
      ],
      "reservationInfo": "現地チケット売場にて購入（歴史文化センター共通券）。",
      "parkingInfo": "無料駐車場あり。",
      "openingHours": "08:00〜18:00（5月〜8月は19:00まで）。"
    }
