    "en": {
      "name": "Enoshima Sea Candle",
      "description": "The Enoshima Sea Candle (Japanese: 江の島シーキャンドル), also known as the Shonan Observatory Lighthouse, is an observation tower and lighthouse located in the Samuel Cocking Garden on the small tidal island of Enoshima in Fujisawa, Kanagawa, Japan. The tower has two observation decks, the primary indoor deck and a secondary outdoor deck. The primary deck can be accessed via a central lift or spiral staircase, while the outdoor deck can only be accessed by a second spiral staircase.",
      "highlights": ["Viewpoint"]
    },
    "ja": {
      "name": "江の島灯台",
      "description": "江の島灯台（えのしまとうだい）は、神奈川県藤沢市江の島に立つ日本初の民間灯台。構造物としての江の島シーキャンドルについても本項で述べる。",
      "highlights": ["展望"]
