  "content": {
    "en": {
      "name": "Kouri Island & Heart Rock",
      "description": "A small circular island connected to Okinawa main island by a 2km scenic sea bridge, famous for crystal clear ocean views and Tiinu Beach's Heart Rock formation.",
      "highlights": [
        "Drive the exhilarating 2,020m Kouri Bridge over turquoise ocean",
        "Visit Heart Rock at Tiinu Beach featured in popular travel media",
        "Ascend Kouri Ocean Tower for panoramic 360-degree island views"
      ],
      "reservationInfo": "Bridge and beaches free access; Kouri Ocean Tower ticket at entrance.",
      "parkingInfo": "Paid parking available at Tiinu Beach (¥100-¥300); free parking at Kouri Beach.",
      "openingHours": "Open 24/7; Kouri Ocean Tower 10:00 - 17:00."
    },
    "ja": {
      "name": "古宇利島・ハートロック",
      "description": "全長2,020mの古宇利大橋で渡る「恋の島」。透き通るブルーの海とティーヌ浜のハート型岩（ハートロック）で有名な人気ドライブスポット。",
      "highlights": [
        "絶景海中道路・古宇利大橋のドライブ体験",
        "ティーヌ浜で見る波の侵食が生んだハートロック",
        "古宇利オーシャンタワーの展望フロアから臨む360度大パノラマ"
      ],
      "reservationInfo": "島およびビーチ散策自由。オーシャンタワーは現地チケット制。",
      "parkingInfo": "古宇利ビーチ無料駐車場あり（ティーヌ浜周辺は有料100円〜300円）。",
      "openingHours": "終日開放（タワー営業10:00〜17:00）。"
    }
  },
