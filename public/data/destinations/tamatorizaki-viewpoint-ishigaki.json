  "content": {
    "en": {
      "name": "Tamatorizaki Observatory",
      "description": "A scenic hill observatory on northeastern Ishigaki Island lined with vibrant red hibiscus flowers, offering panoramic views of Ibaruma Bay and the Hirakubo Peninsula.",
      "highlights": [
        "Walk the gentle hibiscus-lined stone path to the hilltop gazebo",
        "Take in 180-degree views of coral reef ocean gradients and green peninsulas"
      ],
      "reservationInfo": "Free open access.",
      "parkingInfo": "Free public parking lot with clean restroom facilities.",
      "openingHours": "Open 24/7; best visited during daylight hours."
    },
    "ja": {
      "name": "玉取崎展望台",
      "description": "石垣島北東部に位置する人気絶景ポイント。ハイビスカスが咲き誇る遊歩道を登ると、伊原間湾と平久保半島の美しい海と緑のグラデーションが一望できる。",
      "highlights": [
        "一年中ハイビスカスが彩る石畳の展望遊歩道散策",
        "太平洋と東シナ海を包み込むエメラルドグリーンのパノラマビュー"
      ],
      "reservationInfo": "入場自由・無料。",
      "parkingInfo": "無料駐車場完備（公衆トイレ併設）。",
      "openingHours": "終日開放（日中・夕刻の景観がおすすめ）。"
    }
