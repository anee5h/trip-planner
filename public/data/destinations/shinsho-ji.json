  "content": {
    "en": {
      "name": "Shinsho-ji",
      "description": "Narita-san (成田山 \"Narita mountain\") Shinshō-ji (新勝寺 \"New victory temple\") is a Shingon Buddhist temple located in central Narita, Chiba, Japan. It was founded in 940 by Kanchō Daisōjō, a disciple of Kōbō Daishi. It is a lead temple in the Chisan branch (Chisan-ha 智山派) of New Shingon (Shingi Shingon 新義真言宗), includes a large complex of buildings and grounds, and is one of the best-known temples in the Kantō region.",
      "highlights": ["History"]
    },
    "ja": {
      "name": "成田山新勝寺",
      "description": "成田山新勝寺（なりたさんしんしょうじ）は、日本の千葉県成田市成田にある真言宗智山派の仏教寺院であり、同派の大本山の一つである。山号は成田山。本尊は不動明王で、当寺は不動明王信仰の一大中心地である。",
      "highlights": ["歴史"]
    }
  },
