    "en": {
      "name": "Daikanbo Viewpoint",
      "description": "Daikanbo is the premier panoramic viewpoint of the Aso caldera at 936 meters elevation, offering a breathtaking 360-degree view of the five peaks of Mount Aso, the vast caldera floor, and on clear days as far as the Kuju mountain range. The sea of clouds phenomenon at sunrise is particularly spectacular.",
      "highlights": [
        "360° caldera panorama at 936m",
        "Five peaks of Mount Aso in one view",
        "Spectacular sunrise sea of clouds"
      ]
    },
    "ja": {
      "name": "大観峰",
      "description": "大観峰（標高936m）は阿蘇カルデラを一望できる最高の展望スポットで、阿蘇五岳と広大なカルデラの底、晴れた日には九重連山まで360度の大パノラマが広がります。早朝の雲海が特に神秘的で、阿蘇観光のハイライトです。",
      "highlights": [
        "936mの絶景360度カルデラパノラマ",
        "阿蘇五岳の全容を一望",
        "早朝に現れる神秘的な雲海"
      ]
    }
  },
