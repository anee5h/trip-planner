{
  "name": "meguruto",
  "private": true,
  "version": "2.0.0-beta.1",
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-catalogue-assets.mjs && vite",
    "build": "tsc -b && node scripts/copy-catalogue-assets.mjs && vite build && npm run seo:generate && npm run check:ga4-installation && node scripts/inject-pwa-assets.cjs",
    "seo:generate": "tsx scripts/generate-seo-outputs.ts",
    "og:render": "node scripts/render-og-images.mjs",
    "seo:check": "tsx scripts/generate-seo-outputs.ts --check",
    "check:search-console": "tsx scripts/check-search-console-readiness.mjs",
    "verify:pages-functions": "node scripts/verify-pages-functions.mjs",
    "pipeline": "node scripts/pipeline.cjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "check:protected-routes": "node scripts/check-protected-routes.mjs",
    "check:allure-privacy": "node scripts/check-allure-privacy.mjs allure-report",
    "allure:strip-analytics": "node scripts/strip-allure-analytics.mjs allure-report",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate-all": "tsx scripts/validate-all.ts",
    "check:bundle-budget": "node scripts/check-bundle-budget.mjs",
    "audit:catalog-integrity": "tsx scripts/audit-catalog-integrity.ts",
    "audit:wikipedia": "tsx scripts/audit-wikipedia-mappings.ts",
    "migrate:wikipedia-legacy": "tsx scripts/migrate-wikipedia-legacy-provenance.ts",
    "enrich:wikipedia-unmapped": "tsx scripts/enrich-wikipedia-unmapped.ts",
    "enrich:wikipedia-phase3": "tsx scripts/enrich-wikipedia-phase3.ts",
    "typecheck:kai256": "tsc -p tsconfig.kai256.json --noEmit",
    "check:catalog-warnings": "tsx scripts/check-catalog-warnings.ts",
    "check:catalog-warnings:update": "tsx scripts/check-catalog-warnings.ts --update",
    "check:catalog-sync": "tsx scripts/check-catalog-sync.ts",
    "audit:kai-203": "tsx scripts/audit-kai-203-destination-completeness.ts",
    "audit:kai-219": "tsx --tsconfig tsconfig.app.json scripts/audit/kai-219-migration-audit.ts",
    "check:kai-219e2": "vitest run scripts/audit/__tests__/kai-219e2-tooling.test.ts",
    "migrate:kai-219e2": "tsx --tsconfig tsconfig.app.json scripts/kai-219e2-admission-cohort.ts --write",
    "check:kai-250": "vitest run scripts/audit/__tests__/kai-250-tooling.test.ts",
    "check:kai-251": "vitest run scripts/audit/__tests__/kai-251-tooling.test.ts",
    "migrate:kai-251": "tsx --tsconfig tsconfig.app.json scripts/kai-251-local-transport-cohort.ts --write",
    "check:kai-252": "vitest run scripts/audit/__tests__/kai-252-tooling.test.ts",
    "check:kai-252-origin-blockers": "tsx --tsconfig tsconfig.app.json scripts/audit/kai-252-origin-blockers.ts",
    "migrate:kai-252": "tsx --tsconfig tsconfig.app.json scripts/kai-252-local-transport-cohort.ts --write",
    "migrate:kai-250": "tsx --tsconfig tsconfig.app.json scripts/kai-250-local-transport-cohort.ts --write",
    "check:kai-219-benchmark": "vitest run scripts/audit/__tests__/kai-219-five-origin-benchmark.test.ts",
    "check:kai-203": "tsx scripts/audit-kai-203-destination-completeness.ts --strict",
    "check:catalog-ci": "tsx scripts/check-catalog-ci.ts && npm run check:kai-89-structured-templates && npm run check:destination-models && npm run check:kai-203 && npm run check:deprecated-fields",
    "check:deprecated-fields": "tsx scripts/check-deprecated-fields.ts",
    "validate-destinations": "tsx scripts/cli/validate-destinations.ts",
    "validate-destination-details": "tsx scripts/cli/validate-destination-details.ts",
    "validate-places": "tsx scripts/cli/validate-places.ts",
    "validate-collections": "tsx scripts/cli/validate-collections.ts",
    "validate-relationships": "tsx scripts/cli/validate-relationships.ts",
    "validate-images": "tsx scripts/cli/validate-images.ts",
    "validate:images:changed": "tsx scripts/cli/validate-images.ts --changed",
    "validate:images:full": "tsx scripts/cli/validate-images.ts --all",
    "validate-search": "tsx scripts/cli/validate-search.ts",
    "validate-links": "tsx scripts/cli/validate-links.ts",
    "validate:links:changed": "tsx scripts/cli/validate-links.ts --changed",
    "validate:links:full": "tsx scripts/cli/validate-links.ts --all",
    "check:translation-parity": "node scripts/check-translation-parity.cjs",
    "validate:i18n": "npm run check:translation-parity",
    "validate:localization": "vitest run --maxWorkers=2 src/shared/utils/__tests__/collectionLabels.test.ts src/shared/utils/__tests__/localizationCoverage.test.ts src/shared/utils/__tests__/placeLabels.test.ts src/shared/utils/__tests__/recommendationLabels.test.ts src/shared/services/place/__tests__/PlaceCatalog.test.ts",
    "check:branding": "node scripts/check-branding.cjs",
    "report:editorial-freshness": "tsx scripts/report-editorial-freshness.ts",
    "report:editorial-quality": "tsx scripts/report-editorial-quality.ts",
    "audit:major-city-coverage": "tsx scripts/audit-major-city-coverage.ts",
    "audit:destination-depth": "tsx scripts/audit-destination-depth.ts",
    "expand:kai-162-okinawa": "tsx scripts/kai-162-okinawa-expansion.ts",
    "expand:kai-145-kyoto": "tsx scripts/kai-145-kyoto-city-expansion.ts",
    "expand:kai-146-chiba": "tsx scripts/kai-146-northern-chiba-expansion.ts",
    "expand:kai-155-osaka": "tsx scripts/kai-155-osaka-expansion.ts",
    "expand:kai-158-nagoya-aichi": "tsx scripts/kai-158-nagoya-aichi-expansion.ts",
    "expand:kai-156-kobe": "tsx scripts/kai-156-kobe-expansion.ts",
    "expand:kai-157-fukuoka": "tsx scripts/kai-157-fukuoka-expansion.ts",
    "expand:major-city-catalog": "tsx scripts/expand-major-city-catalog.ts",
    "audit:v192-expansion-data": "tsx scripts/audit-v192-expansion-data.ts",
    "audit:kai-89-structured-templates": "tsx scripts/audit-kai-89-structured-templates.ts",
    "check:kai-89-structured-templates": "tsx scripts/audit-kai-89-structured-templates.ts --check",
    "repair:destination": "tsx scripts/repair-destination.ts",
    "sync-destination-details": "tsx scripts/sync-destination-details.ts",
    "normalize-destination-budgets": "tsx scripts/normalize-destination-budgets.ts",
    "add-recommended-visit-hours": "tsx scripts/add-recommended-visit-hours.ts",
    "normalize-legacy-ratings": "tsx scripts/normalize-legacy-ratings.ts",
    "apply-city-hub-relationships": "tsx scripts/apply-city-hub-relationships.ts",
    "add-reviewed-city-hubs": "tsx scripts/add-reviewed-city-hubs.ts",
    "classify-standalone-destinations": "tsx scripts/classify-standalone-destinations.ts",
    "normalize-municipality-names": "tsx scripts/normalize-municipality-names.ts",
    "add-yokohama-places": "tsx scripts/add-yokohama-places.ts",
    "validate:catalog-fast": "tsx scripts/validate-all.ts --profile fast --no-report",
    "verify:pr": "npm run test:run && npx tsc -b --noEmit && npm run typecheck:kai256 && npm run lint && npm run format:check && npm run validate:i18n && npm run validate:localization && npm run check:branding && npm run validate:catalog-fast && npm run check:catalog-ci && npm run build && npm run seo:check && npm run verify:pages-functions",
    "release:verify": "npm run test:run && npm run pipeline -- --dry-run && npm run validate-all && npm run validate:i18n && npm run check:branding && npx tsc -b --noEmit && npm run lint && npm run build && npm run format:check",
    "derive:destination-models": "tsx scripts/derive-destination-models.ts",
    "derive:destination-models:apply": "tsx scripts/derive-destination-models.ts --apply",
    "check:destination-models": "tsx scripts/derive-destination-models.ts --check && tsx scripts/models/validate-models.ts",
    "check:security-headers": "node scripts/check-security-headers.mjs",
    "check:ga4-installation": "node scripts/check-ga4-installation.mjs",
    "check:bundle-secrets": "node scripts/check-bundle-secrets.mjs",
    "test:pwa": "PWA_E2E=1 playwright test --workers=1 e2e/kai-64-pwa.spec.ts e2e/kai-64-upgrade.spec.ts e2e/kai-121-lazy-catalogue.spec.ts",
    "test:a11y": "A11Y_E2E=1 playwright test --workers=1 e2e/kai-80-a11y.spec.ts",
    "check:pwa": "node scripts/check-pwa.cjs",
    "expand:kai-154-shiga": "tsx scripts/kai-154-shiga-expansion.ts",
    "expand:kai-161-uji-northern-kyoto": "tsx scripts/kai-161-uji-northern-kyoto-expansion.ts",
    "expand:kai-149-awaji-southern-nara": "tsx scripts/kai-149-awaji-southern-nara-expansion.ts",
    "expand:kai-148-shikoku-interior": "tsx scripts/kai-148-shikoku-interior-expansion.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@react-map/japan": "^1.0.10",
    "@supabase/supabase-js": "^2.112.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "i18next": "^26.4.0",
    "jose": "^6.2.10",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.33.0",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.12",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@axe-core/playwright": "^4.13.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.10.2",
    "autoprefixer": "^10.5.4",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "oxlint": "^1.79.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,json,css,md}": [
      "prettier --write"
    ]
  },
  "allowScripts": {
    "wrangler@4.125.0": true
  }
}
