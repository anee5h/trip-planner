{
  "name": "tabimap",
  "private": true,
  "version": "1.9.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "pipeline": "node scripts/pipeline.cjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate-all": "tsx scripts/validate-all.ts",
    "validate-destinations": "tsx scripts/cli/validate-destinations.ts",
    "validate-destination-details": "tsx scripts/cli/validate-destination-details.ts",
    "validate-places": "tsx scripts/cli/validate-places.ts",
    "validate-collections": "tsx scripts/cli/validate-collections.ts",
    "validate-relationships": "tsx scripts/cli/validate-relationships.ts",
    "validate-images": "tsx scripts/cli/validate-images.ts",
    "validate-search": "tsx scripts/cli/validate-search.ts",
    "validate-links": "tsx scripts/cli/validate-links.ts",
    "check:translation-parity": "node scripts/check-translation-parity.cjs",
    "validate:i18n": "npm run check:translation-parity",
    "report:editorial-freshness": "tsx scripts/report-editorial-freshness.ts",
    "audit:major-city-coverage": "tsx scripts/audit-major-city-coverage.ts",
    "expand:major-city-catalog": "tsx scripts/expand-major-city-catalog.ts",
    "audit:v192-expansion-data": "tsx scripts/audit-v192-expansion-data.ts",
    "repair:destination": "tsx scripts/repair-destination.ts",
    "sync-destination-details": "tsx scripts/sync-destination-details.ts",
    "normalize-destination-budgets": "tsx scripts/normalize-destination-budgets.ts",
    "add-recommended-visit-hours": "tsx scripts/add-recommended-visit-hours.ts",
    "normalize-legacy-ratings": "tsx scripts/normalize-legacy-ratings.ts",
    "apply-city-hub-relationships": "tsx scripts/apply-city-hub-relationships.ts",
    "add-reviewed-city-hubs": "tsx scripts/add-reviewed-city-hubs.ts",
    "classify-standalone-destinations": "tsx scripts/classify-standalone-destinations.ts",
    "normalize-municipality-names": "tsx scripts/normalize-municipality-names.ts",
    "add-yokohama-places": "tsx scripts/add-yokohama-places.ts",
    "validate:catalog-fast": "tsx scripts/validate-all.ts --profile fast --no-report",
    "verify:pr": "npm run test:run && npx tsc -b --noEmit && npm run lint && npm run format:check && npm run validate:i18n && npm run validate:catalog-fast && npm run build",
    "release:verify": "npm run test:run && npm run pipeline -- --dry-run && npm run validate-all && npm run validate:i18n && npx tsc -b --noEmit && npm run lint && npm run build && npm run format:check"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@react-map/japan": "^1.0.10",
    "@supabase/supabase-js": "^2.110.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.3.6",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.11",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.2.0",
    "oxlint": "^1.76.0",
    "postcss": "^8.5.25",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "~7.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,json,css,md}": [
      "prettier --write"
    ]
  }
}
